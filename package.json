{
  "name": "loopmark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-public-pages.mjs && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sync": "node scripts/test-sync-smoke.mjs",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write src tests scripts *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json .github/workflows/*.yml",
    "doctor": "node scripts/doctor.mjs",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:reset": "node scripts/local.mjs reset",
    "test:server": "node scripts/test-server.mjs",
    "local:status": "node scripts/local.mjs status",
    "native:sync": "npm run build && node scripts/native/sync.mjs",
    "native:ios:build": "node scripts/native/build-ios.mjs",
    "native:android:build": "node scripts/native/build-android.mjs",
    "test:native:ios": "node scripts/native/test-ios.mjs",
    "test:native:android": "node scripts/native/test-android.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:release:contracts": "node --test tests/release/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-audio-recorder": "8.3.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "@supabase/supabase-js": "2.118.0",
    "@tabler/icons-react": "^3.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
