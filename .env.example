# All entries are optional for guest web. Copy only needed settings to .env.local.
# Explicit process environment overrides .env.local. Never commit .env.local or secrets.
# PUBLIC browser/native settings: these values are bundled. No service-role/provider secret here.
# Cloud requires all three. Example origins: https://app.example.com and https://project.supabase.co.
VITE_LOOPMARK_APP_ORIGIN=
VITE_LOOPMARK_SUPABASE_URL=
# Supabase sb_publishable_... or a legacy JWT whose role is anon. Never sb_secret_... or service_role.
VITE_LOOPMARK_SUPABASE_ANON_KEY=
# Optional integer 1..4; default 2. Does not change server admission or quota.
VITE_LOOPMARK_MEDIA_CONCURRENCY=2

# Public help-page contact, rendered as a plain mailbox in static HTML. Never use a personal secret.
# Leave empty for a local build; supply the actual service contact before public account enrollment.
LOOPMARK_PUBLIC_SUPPORT_EMAIL=

# LOCAL TOOLS ONLY. Default profile/project/ports derive from the canonical worktree path.
# Override profile using 1..32 lowercase letters/digits/hyphens, beginning with a letter/digit.
LOOPMARK_DEV_PROFILE=
# Optional distinct integer ports 1024..65535. Collision probes never reuse unknown processes.
LOOPMARK_DEV_APP_PORT=
LOOPMARK_DEV_API_PORT=
LOOPMARK_DEV_DB_PORT=
LOOPMARK_DEV_STUDIO_PORT=
LOOPMARK_DEV_MAIL_PORT=
# Optional http://127.0.0.1:<profile-api-port>; remote URLs and mismatched ports are rejected.
LOOPMARK_LOCAL_URL=

# SERVER ONLY, required before server startup. Not Vite variables. Never copied into the public bundle.
# Environment: local|staging|production. Production requires HTTPS.
# Local server backend accepts loopback or exactly http://kong:8000 inside the Supabase Edge container.
# The internal gateway is never a permitted browser or operator URL.
LOOPMARK_ENVIRONMENT=local
LOOPMARK_PROJECT_ID=
LOOPMARK_APP_ORIGIN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enrollment defaults false. Configuration does not grant a user entitlement.
LOOPMARK_CLOUD_ENROLLED=false
# Qualify/activate each provider separately. Secret presence never activates payments.
LOOPMARK_RAZORPAY_ENROLLED=false
LOOPMARK_REVENUECAT_ENROLLED=false
LOOPMARK_PAYMENT_ENVIRONMENT=sandbox
# Nonnegative integer alert durations, milliseconds. Zero alerts immediately; it never disables a policy.
# Sync/webhook maximum 86400000; deletion/backup maximum 604800000.
LOOPMARK_SYNC_ALERT_MS=300000
LOOPMARK_WEBHOOK_ALERT_MS=300000
LOOPMARK_DELETION_ALERT_MS=86400000
LOOPMARK_BACKUP_ALERT_MS=86400000

# PROVIDER SERVER SECRETS. Required only for authorized provider sandbox / enrolled payment service.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Sandbox must use rzp_test_...; production must use rzp_live_... with explicit live enrollment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Native app public SDK keys and approved store product IDs. Server delivers these only
# through authenticated, enrolled billing configuration; these are never VITE_ settings.
# RevenueCat Test Store keys cannot qualify real iOS/Android sandbox readiness.
LOOPMARK_REVENUECAT_IOS_KEY=
LOOPMARK_REVENUECAT_ANDROID_KEY=
LOOPMARK_REVENUECAT_IOS_PRODUCTS=
LOOPMARK_REVENUECAT_ANDROID_PRODUCTS=

# Independent erasure ledger: both fields together; local launcher generates a profile-specific
# 256-bit hex credential. The exact internal origin is local-only. Hosted service requires HTTPS.
# Independent deployment and restore qualification are required before live cloud enrollment.
LOOPMARK_ERASURE_LEDGER_URL=
LOOPMARK_ERASURE_LEDGER_KEY=

# Auth callbacks are derived as <validated app origin>/auth/callback. No redirect override exists.
# No configuration can override ownership, CAS, generation, entitlements or backup/data limits.
