        "sequence": { "type": "string" },
        "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
        "base": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": { "revision": { "type": "string" } },
                  "required": ["revision"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "afterOperationId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    }
                  },
                  "required": ["afterOperationId"],
                  "additionalProperties": false
